{
  "manifest_version": 3,
  "name": "ForceBGTab",
  "version": "0.2.0",
  "description": "Forces new tabs opened from links to open in the background so they never steal focus. Background-only, no page access.",
  "permissions": ["tabs", "storage"],
  "background": {
    "scripts": ["src/browser-api.js", "src/background.js"]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "forcebgtab@sysadmindoc.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
